  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "THE FINAL SECRET\n\n\n\"Brave explorer, you have claimed the ancient treasure,
    but your journey is not yet over.\n\n    The temple will not release you without
    the Final Key.\n\n    Return to the hallway where you discovered the second whisper.
    Take the path opposite the second chamber and descend into the basement.\n\n   
    There, an ancient lever awaits. Pull it to unlock the hidden door.\n\n    Beyond
    the door, follow the stairs to the forgotten quarters. The Final Key rests within.\n\n   
    Claim it, return to the main gate, and earn your freedom.\"\n\nYour treasure
    is found. Your escape is not.\n\nPress E to close"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
